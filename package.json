{
  "name": "contato-emergencia",
  "version": "1.0.0",
  "private": true,
  "description": "Gera páginas estáticas de contato de emergência para ciclistas (acessadas por QR code).",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node src/cli/build.ts",
    "dev": "node src/cli/build.ts && node src/cli/servir.ts",
    "nova-pessoa": "node src/cli/nova-pessoa.ts",
    "trocar-codigo": "node src/cli/trocar-codigo.ts",
    "publicar": "node src/cli/publicar.ts",
    "dados:exportar": "node src/cli/exportar-dados.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
